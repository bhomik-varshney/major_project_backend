APP_ENV=development
DATABASE_URL=sqlite:///./.data/careeros.db
# Optional PostgreSQL: postgresql+psycopg://student:password@localhost:5432/careeros
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
DATA_DIR=.data
MAX_DOCUMENT_BYTES=5242880
# Optional MiB override; when set, takes precedence over MAX_DOCUMENT_BYTES.
MAX_DOCUMENT_SIZE_MB=5
MAX_DOCUMENTS_PER_USER=20
DOCUMENT_STORAGE_PATH=.data/documents
MAX_EXTRACTION_PAGES=50
MAX_EXTRACTION_CHARS=60000
AUTO_INIT_DB=true
# Optional: generated and persisted privately in DATA_DIR when absent.
# SESSION_SECRET=
# Optional, backend only. Empty slots use controlled local fallback.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# Legacy alias for slot 1 when GROQ_API_KEY_1 is empty.
GROQ_API_KEY=
# Legacy text alias; GROQ_TEXT_MODEL takes precedence when nonempty.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL_PRIMARY=qwen/qwen3.8-27b
GROQ_VISION_MODEL_FALLBACK=
RENDER_MAX_PAGES=12
VISION_MAX_PAGES=3
RENDER_MAX_DIMENSION=2200
PREPARATION_TIMEOUT_SECONDS=50
OCR_ENABLED=true
# Optional absolute executable path; otherwise discovered locally.
LIBREOFFICE_PATH=
GROQ_MAX_OUTPUT_TOKENS=3500
GROQ_TIMEOUT_SECONDS=30
GROQ_KEY_COOLDOWN_SECONDS=5
CREW_TIMEOUT_SECONDS=75

# Bounded source-only text batches; originals remain complete in the audit.
GROQ_SOURCE_BATCH_CHARS=9000
GROQ_MAX_BATCHES=8

# Confirmed-profile matching. Default runs locally with explicit TF-IDF fallback.
MATCHING_TIMEOUT_SECONDS=120
MATCHING_MINIMUM_SCORE=30
MATCHING_CRITICAL_PENALTY=15
MATCHING_UNKNOWN_CEILING_BASE=50
MATCHING_AI_TOP_K=8
MATCHING_WEIGHTS={"semantic":0.20,"required_skills":0.30,"preferred_skills":0.08,"title_category":0.12,"project_experience":0.10,"education":0.04,"experience":0.06,"location":0.05,"interests":0.05}
# Optional existing local Ollama service/model; no automatic model download.
MATCHING_EMBEDDING_TIMEOUT_SECONDS=30
MATCHING_EMBEDDING_PROVIDER=none
MATCHING_EMBEDDING_MODEL=nomic-embed-text
MATCHING_EMBEDDING_URL=http://127.0.0.1:11434/api/embed

# Connected canonical resume validation; external repair still requires run consent.
RESUME_MAX_REPAIR_CYCLES=3
RESUME_REPAIR_TIMEOUT_SECONDS=45
