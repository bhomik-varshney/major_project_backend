APP_ENV=development
DATABASE_URL=sqlite:///./.data/careeros.db
# Optional PostgreSQL: postgresql+psycopg://student:password@localhost:5432/careeros
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
DATA_DIR=.data
MAX_DOCUMENT_BYTES=5242880
MAX_DOCUMENTS_PER_USER=20
AUTO_INIT_DB=true
# Optional: generated and persisted privately in DATA_DIR when absent.
# SESSION_SECRET=
# No Groq or job-provider keys are used by this milestone.
